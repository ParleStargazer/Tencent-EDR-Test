{
  "schema_version": "1.1",
  "capability_id": "win.account.logoff",
  "version": "0.1.0",
  "display_name_zh": "账号注销",
  "display_name_en": "Account Logoff",
  "description": "Actor 为唯一临时本地账号建立网络登录令牌，记录 AuthenticationId，并以关闭该令牌的时刻作为注销基准；Controller 核验同一账号与会话身份。",
  "platform": { "os": "windows", "minimum_version": "10.0.17763", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "administrator",
  "controller": { "executable": "AccountLogoff.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "AccountLogoff.Actor.exe" }],
  "parameters": {
    "setup_delay_ms": { "type": "integer", "required": true, "default": 750, "minimum": 0, "maximum": 30000 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 45, "cleanup_seconds": 20 },
  "network": { "required": false },
  "expected_fact_keys": [
    "account.logoff_succeeded", "account.occurred_at_utc", "account.name", "account.sid", "account.domain",
    "account.actor_pid", "account.actor_executable", "account.native_api", "account.session.logon_id", "account.session.logon_type",
    "account.session.authentication_package", "account.session.source_address", "account.session.token_validated", "correlation.nonce"
  ]
}
