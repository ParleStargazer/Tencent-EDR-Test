{
  "schema_version": "1.1",
  "capability_id": "win.account.local.delete",
  "version": "0.1.0",
  "display_name_zh": "本地账号删除",
  "display_name_en": "Local Account Deletion",
  "description": "Actor 创建唯一临时本地账号作为受控前置条件，再使用 NetUserDel 删除；Controller 独立确认同一 SID 的账号由存在变为不存在。",
  "platform": { "os": "windows", "minimum_version": "10.0.17763", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "administrator",
  "controller": { "executable": "AccountLocalDelete.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "AccountLocalDelete.Actor.exe" }],
  "parameters": {
    "setup_delay_ms": { "type": "integer", "required": true, "default": 750, "minimum": 0, "maximum": 30000 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 45, "cleanup_seconds": 20 },
  "network": { "required": false },
  "expected_fact_keys": [
    "account.local_delete_succeeded", "account.occurred_at_utc", "account.name", "account.sid", "account.domain", "account.account_type",
    "account.actor_pid", "account.actor_executable", "account.native_api", "account.before.exists", "account.after.exists", "correlation.nonce"
  ]
}
