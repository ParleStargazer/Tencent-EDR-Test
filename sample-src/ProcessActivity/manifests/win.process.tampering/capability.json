{
  "schema_version": "1.1",
  "capability_id": "win.process.tampering",
  "version": "0.1.0",
  "display_name_zh": "进程篡改活动",
  "display_name_en": "Process Tampering Activity",
  "description": "Actor 仅在本轮受控 Target 中分配缓冲区，写入带 nonce 的数据并回读哈希验证。",
  "platform": {
    "os": "windows",
    "minimum_version": "10.0.19041",
    "architectures": ["x64"]
  },
  "risk_level": "L2",
  "required_privilege": "standard_user",
  "controller": { "executable": "ProcessTampering.Controller.exe" },
  "participants": [
    { "role": "actor", "executable": "ProcessTampering.Actor.exe" },
    { "role": "target", "executable": "ProcessTampering.Target.exe" }
  ],
  "parameters": {
    "payload_size": {
      "type": "integer",
      "required": true,
      "default": 64,
      "minimum": 16,
      "maximum": 4096
    }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "process.tamper_succeeded",
    "process.target_pid",
    "process.before_sha256",
    "process.after_sha256",
    "process.memory_released",
    "correlation.nonce"
  ]
}
