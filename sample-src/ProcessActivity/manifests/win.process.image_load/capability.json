{
  "schema_version": "1.1",
  "capability_id": "win.process.image_load",
  "version": "0.4.1",
  "display_name_zh": "加载镜像或动态库",
  "display_name_en": "Image/Library Loaded",
  "description": "Actor 同时触发受控 Target 的四种原生 DLL 加载，以及 dotnet 托管辅助进程加载刚写入的程序集；新增方法加载随包提供的无签名应用私有 e_sqlite3.dll 副本并调用只读版本导出，Controller 对五个子项分别验证。",
  "platform": {
    "os": "windows",
    "minimum_version": "10.0.19041",
    "architectures": ["x64"]
  },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "ImageLoad.Controller.exe" },
  "participants": [
    { "role": "actor", "executable": "ImageLoad.Actor.exe" },
    { "role": "target", "executable": "ImageLoad.Target.exe" }
  ],
  "parameters": {
    "library_name": {
      "type": "string",
      "required": true,
      "default": "winhttp.dll",
      "allowed_values": ["winhttp.dll", "dbghelp.dll", "version.dll"]
    },
    "application_local_library_name": {
      "type": "string",
      "required": true,
      "default": "version.dll",
      "allowed_values": ["version.dll", "winhttp.dll", "dbghelp.dll"]
    },
    "loadlibraryex_library_name": {
      "type": "string",
      "required": true,
      "default": "dbghelp.dll",
      "allowed_values": ["dbghelp.dll", "version.dll", "winhttp.dll"]
    },
    "post_load_hold_ms": {
      "type": "integer",
      "required": true,
      "default": 5000,
      "minimum": 500,
      "maximum": 10000
    }
  },
  "timeouts": { "execute_seconds": 75, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "process.image_load_succeeded",
    "process.target_pid",
    "process.image_path",
    "process.image_sha256",
    "process.image_load_subtest_count",
    "process.image_load.system_loadlibrary.succeeded",
    "process.image_load.system_loadlibrary.path",
