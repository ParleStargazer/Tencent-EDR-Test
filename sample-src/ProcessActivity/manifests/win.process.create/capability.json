{
  "schema_version": "1.1",
  "capability_id": "win.process.create",
  "version": "0.1.0",
  "display_name_zh": "进程创建",
  "display_name_en": "Process Creation",
  "description": "Actor 创建带本轮 nonce 的 Target，Controller 独立确认 PID、父子关系和存活状态。",
  "platform": {
    "os": "windows",
    "minimum_version": "10.0.19041",
    "architectures": ["x64"]
  },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "ProcessCreate.Controller.exe" },
  "participants": [
    { "role": "actor", "executable": "ProcessCreate.Actor.exe" },
    { "role": "target", "executable": "ProcessCreate.Target.exe" }
  ],
  "parameters": {
    "target_lifetime_ms": {
      "type": "integer",
      "required": true,
      "default": 5000,
      "minimum": 1000,
      "maximum": 30000
    }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "process.create_succeeded",
    "process.child_pid",
    "process.parent_pid",
    "correlation.nonce"
  ]
}
