{
  "schema_version": "1.1",
  "capability_id": "win.file.create",
  "version": "0.2.0",
  "display_name_zh": "文件创建",
  "display_name_en": "File Creation",
  "description": "Actor 分别使用 CreateNew 创建 TXT 与有效 JSON 两个唯一 nonce 文件，Controller 独立校验文件存在、大小与哈希。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "FileCreate.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "FileCreate.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "file.create_succeeded", "correlation.nonce",
    "file.txt.create_succeeded", "file.txt.occurred_at_utc", "file.txt.actor_pid", "file.txt.actor_executable", "file.txt.extension", "file.txt.path",
    "file.txt.after.exists", "file.txt.after.size_bytes", "file.txt.after.md5", "file.txt.after.sha256",
    "file.json.create_succeeded", "file.json.occurred_at_utc", "file.json.actor_pid", "file.json.actor_executable", "file.json.extension", "file.json.path",
    "file.json.after.exists", "file.json.after.size_bytes", "file.json.after.md5", "file.json.after.sha256"
  ]
}
