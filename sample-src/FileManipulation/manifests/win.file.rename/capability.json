{
  "schema_version": "1.1",
  "capability_id": "win.file.rename",
  "version": "0.2.0",
  "display_name_zh": "文件重命名",
  "display_name_en": "File Renaming",
  "description": "Actor 分别将 TXT 与有效 JSON nonce 文件移动到唯一目标名，Controller 独立校验源消失、目标出现且内容哈希保持一致。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "FileRename.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "FileRename.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "file.rename_succeeded", "correlation.nonce",
    "file.txt.rename_succeeded", "file.txt.occurred_at_utc", "file.txt.actor_pid", "file.txt.actor_executable", "file.txt.extension", "file.txt.source_path", "file.txt.destination_path",
    "file.txt.before.md5", "file.txt.after.md5", "file.txt.after.size_bytes", "file.txt.source_after.exists", "file.txt.destination_before.exists",
    "file.json.rename_succeeded", "file.json.occurred_at_utc", "file.json.actor_pid", "file.json.actor_executable", "file.json.extension", "file.json.source_path", "file.json.destination_path",
    "file.json.before.md5", "file.json.after.md5", "file.json.after.size_bytes", "file.json.source_after.exists", "file.json.destination_before.exists"
  ]
}
