{
  "schema_version": "1.1",
  "capability_id": "win.file.open",
  "version": "0.1.0",
  "display_name_zh": "文件打开",
  "display_name_en": "File Opened",
  "description": "Actor 以读写方式打开既有 nonce 文件，完整读取并原样回写；Controller 用前后哈希证明内容未改变。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "FileOpen.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "FileOpen.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "file.open_succeeded", "file.occurred_at_utc", "file.actor_pid", "file.path",
    "file.before.md5", "file.after.md5", "file.after.size_bytes", "file.open.content_unchanged",
    "file.open.bytes_read", "file.open.bytes_written", "correlation.nonce"
  ]
}
