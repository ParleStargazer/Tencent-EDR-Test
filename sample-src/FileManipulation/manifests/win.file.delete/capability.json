{
  "schema_version": "1.1",
  "capability_id": "win.file.delete",
  "version": "0.2.0",
  "display_name_zh": "文件删除",
  "display_name_en": "File Deletion",
  "description": "Actor 分别删除 Controller 预置的 TXT 与有效 JSON nonce 文件，Controller 独立校验删除前元数据与删除后不存在状态。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "FileDelete.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "FileDelete.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "file.delete_succeeded", "correlation.nonce",
    "file.txt.delete_succeeded", "file.txt.occurred_at_utc", "file.txt.actor_pid", "file.txt.actor_executable", "file.txt.extension", "file.txt.path",
    "file.txt.before.exists", "file.txt.before.size_bytes", "file.txt.before.md5", "file.txt.after.exists",
    "file.json.delete_succeeded", "file.json.occurred_at_utc", "file.json.actor_pid", "file.json.actor_executable", "file.json.extension", "file.json.path",
    "file.json.before.exists", "file.json.before.size_bytes", "file.json.before.md5", "file.json.after.exists"
  ]
}
