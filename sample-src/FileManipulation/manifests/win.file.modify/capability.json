{
  "schema_version": "1.1",
  "capability_id": "win.file.modify",
  "version": "0.1.0",
  "display_name_zh": "文件修改",
  "display_name_en": "File Modification",
  "description": "Actor 以 Create 覆盖写既有 nonce 文件，Controller 独立校验内容哈希变化、大小与写入字节数。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "FileModify.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "FileModify.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "file.modify_succeeded", "file.occurred_at_utc", "file.actor_pid", "file.path",
    "file.before.md5", "file.after.md5", "file.after.size_bytes", "file.modify.bytes_written", "correlation.nonce"
  ]
}
