{
  "schema_version": "1.1",
  "capability_id": "win.hash.imphash",
  "version": "0.1.0",
  "display_name_zh": "导入表哈希",
  "display_name_en": "IMPHASH",
  "description": "Actor 使用 CreateNew 创建本轮唯一 EXE 文件；文件是 Actor PE 的字节级副本，Controller 独立解析导入表并复算 IMPHASH。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "HashImpHash.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "HashImpHash.Actor.exe" }],
  "parameters": {
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "hash.operation_succeeded", "hash.occurred_at_utc", "hash.actor_pid", "hash.actor_executable",
    "hash.extension", "hash.path", "hash.file_size_bytes", "hash.algorithm", "hash.digest", "hash.imphash",
    "hash.is_portable_executable", "hash.import_count", "hash.source_pe_path", "hash.source_pe_sha256",
    "hash.source_matches_target"
  ]
}
