{
  "schema_version": "1.1",
  "capability_id": "win.group_policy.modify",
  "version": "0.3.0",
  "display_name_zh": "组策略修改",
  "display_name_en": "Group Policy Modification",
  "description": "同轮执行隔离策略键控制组和真实白名单策略值同值回写；若没有已存在值，临时预置安全增强值 EnableSmartScreen=1，采证后精确恢复原状态。",
  "platform": { "os": "windows", "minimum_version": "10.0.17763", "architectures": ["x64"] },
  "risk_level": "L2",
  "required_privilege": "administrator",
  "controller": { "executable": "GroupPolicyModify.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "GroupPolicyModify.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 },
    "known_policy_target": {
      "type": "string",
      "required": true,
      "default": "auto",
      "allowed_values": [
        "auto",
        "windows-smart-screen-enable",
        "windows-smart-screen-level",
        "defender-smart-screen-control",
        "defender-smart-screen-enable",
        "windows-lsa-run-as-ppl",
        "defender-disable-antispyware",
        "defender-realtime-monitoring"
      ]
    }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "group_policy.modify_succeeded",
    "group_policy.isolated_policy_key.modify_succeeded",
    "group_policy.isolated_policy_key.occurred_at_utc",
    "group_policy.isolated_policy_key.key_path",
    "group_policy.isolated_policy_key.value_name",
    "group_policy.isolated_policy_key.actor_pid",
    "group_policy.known_policy_same_value.applicable",
    "group_policy.known_policy_same_value.prepared_for_test",
    "group_policy.known_policy_same_value.original_value_exists",
    "group_policy.known_policy_same_value.requested_target",
    "correlation.nonce"
  ]
}
