{
  "schema_version": "1.1",
  "capability_id": "win.network.dns",
  "version": "0.2.0",
  "display_name_zh": "DNS 查询",
  "display_name_en": "DNS Query",
  "description": "同轮执行受控原始 UDP DNS 与 Windows DnsQuery_W 子测试；后者通过 DNS Client 服务发起查询，并记录 Dnscache 所在 svchost PID 作为云端关联基准。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": { "executable": "NetworkDns.Controller.exe" },
  "participants": [
    { "role": "actor", "executable": "NetworkDns.Actor.exe" },
    { "role": "helper", "executable": "NetworkDns.Helper.exe" }
  ],
  "parameters": {
    "setup_delay_ms": { "type": "integer", "required": true, "default": 250, "minimum": 0, "maximum": 5000 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 },
    "payload_size": { "type": "integer", "required": true, "default": 8192, "minimum": 256, "maximum": 1048576 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": true },
  "expected_fact_keys": [
    "network.dns_query_succeeded", "network.subtest_count", "correlation.nonce",
    "network.dns.raw_udp.succeeded", "network.dns.raw_udp.occurred_at_utc", "network.dns.raw_udp.actor_pid", "network.dns.raw_udp.actor_executable",
    "network.dns.raw_udp.remote.port", "network.dns.raw_udp.question", "network.dns.raw_udp.query_type",
    "network.dns.windows_dns_client.succeeded", "network.dns.windows_dns_client.occurred_at_utc", "network.dns.windows_dns_client.actor_pid",
    "network.dns.windows_dns_client.question", "network.dns.windows_dns_client.native_api", "network.dns.windows_dns_client.native_status_code",
    "network.dns.windows_dns_client.service_pid", "network.dns.windows_dns_client.service_executable"
  ]
}
