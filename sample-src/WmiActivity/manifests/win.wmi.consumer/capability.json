{
  "schema_version": "1.1",
  "capability_id": "win.wmi.consumer",
  "version": "0.1.0",
  "display_name_zh": "WMI 事件消费者",
  "display_name_en": "WMI Event Consumer",
  "description": "在 ROOT\\subscription 中创建无命令副作用的唯一 LogFileEventConsumer，Actor 与 Controller 分别核验名称、类、日志路径和文本模板，随后按受控名称清理。",
  "platform": { "os": "windows", "minimum_version": "10.0.17763", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "administrator",
  "controller": { "executable": "WmiEventConsumer.Controller.exe" },
  "participants": [
    { "role": "actor", "executable": "WmiEventConsumer.Actor.exe" }
  ],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1000, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 90, "cleanup_seconds": 30 },
  "network": { "required": false },
  "expected_fact_keys": [
    "wmi.operation_succeeded", "wmi.operation", "wmi.occurred_at_utc", "wmi.completed_at_utc",
    "wmi.namespace", "wmi.object_name", "wmi.object_class", "wmi.object_path",
    "wmi.consumer_name", "wmi.consumer_path", "wmi.consumer_class", "wmi.log_file_path", "wmi.text_template",
    "wmi.controller_verified", "wmi.actor_verified", "wmi.cleanup_succeeded",
    "wmi.actor_pid", "wmi.actor_executable", "wmi.actor_command_line", "correlation.nonce"
  ]
}
