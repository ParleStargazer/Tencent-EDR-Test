  "version": "0.3.0",
  "display_name_zh": "计划任务修改",
  "display_name_en": "Scheduled Task Modification",
  "description": "运行 Task Scheduler COM/RPC Hook 与 Windows 安全审计更新两个独立子测试；安全审计方法临时启用其他对象访问成功审核，通过 schtasks.exe /Create /XML /F 覆盖既有任务并激发 4702，随后恢复原审核策略。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L2",
  "required_privilege": "administrator",
  "controller": { "executable": "ScheduledTaskModify.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "ScheduledTaskModify.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 60, "cleanup_seconds": 15 },
  "network": { "required": false },
