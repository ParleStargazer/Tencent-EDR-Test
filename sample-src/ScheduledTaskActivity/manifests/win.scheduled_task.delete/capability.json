{
  "schema_version": "1.1",
  "capability_id": "win.scheduled_task.delete",
  "version": "0.3.0",
  "display_name_zh": "计划任务删除",
  "display_name_en": "Scheduled Task Deletion",
  "description": "运行 Task Scheduler COM 删除与 Windows 安全审计删除两个独立子测试；安全审计方法临时启用其他对象访问成功审核，通过 schtasks.exe /Delete 激发 4699 并恢复原审核策略。腾讯 EDR 暂无删除事件实现，本轮仅要求行为与本机审核证据成功。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L2",
  "required_privilege": "administrator",
  "controller": { "executable": "ScheduledTaskDelete.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "ScheduledTaskDelete.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 60, "cleanup_seconds": 15 },
  "network": { "required": false },
