{
  "schema_version": "1.1",
  "capability_id": "win.registry.modify",
  "version": "0.1.0",
  "display_name_zh": "键/值修改",
  "display_name_en": "Key/Value Modification",
  "description": "Controller 预置本轮唯一 HKCU 键值，Actor 将 REG_SZ 数据修改为含 nonce 的新值，Controller 独立校验前后数据和 SHA-256 均发生变化。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "standard_user",
  "controller": { "executable": "RegistryModify.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "RegistryModify.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "registry.modify_succeeded", "registry.occurred_at_utc", "registry.hive", "registry.key_path", "registry.value_name", "registry.view",
    "registry.actor_pid", "registry.actor_executable", "registry.actor_command_line",
    "registry.before.key_exists", "registry.before.value_exists", "registry.before.value_kind", "registry.before.value_data", "registry.before.value_data_sha256",
    "registry.after.key_exists", "registry.after.value_exists", "registry.after.value_kind", "registry.after.value_data", "registry.after.value_data_sha256",
    "correlation.nonce"
  ]
}
