{
  "schema_version": "1.1",
  "capability_id": "win.registry.create",
  "version": "0.1.0",
  "display_name_zh": "键/值创建",
  "display_name_en": "Key/Value Creation",
  "description": "Actor 在 HKCU\\Software\\EdrTest 下创建本轮唯一键并写入唯一 REG_SZ 值，Controller 独立校验键、值名、类型和数据。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "standard_user",
  "controller": { "executable": "RegistryCreate.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "RegistryCreate.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "registry.create_succeeded", "registry.occurred_at_utc", "registry.hive", "registry.key_path", "registry.value_name", "registry.view",
    "registry.actor_pid", "registry.actor_executable", "registry.actor_command_line",
    "registry.before.key_exists", "registry.before.value_exists",
    "registry.after.key_exists", "registry.after.value_exists", "registry.after.value_kind", "registry.after.value_data", "registry.after.value_data_sha256",
    "correlation.nonce"
  ]
}
