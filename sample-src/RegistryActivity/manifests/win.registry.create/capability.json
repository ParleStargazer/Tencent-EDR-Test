  "display_name_zh": "键/值创建",
  "display_name_en": "Key/Value Creation",
  "description": "同轮执行隔离 HKCU 键（.NET API）与 HKCU Run 启动项（Win32 API）两个独立创建子测试；值名按轮次唯一，Controller 独立校验并精确清理。",
  "platform": { "os": "windows", "minimum_version": "10.0.19041", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "standard_user",
  "controller": { "executable": "RegistryCreate.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "RegistryCreate.Actor.exe" }],
  "parameters": {
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 30, "cleanup_seconds": 10 },
  "network": { "required": false },
  "expected_fact_keys": [
    "registry.create_succeeded",
    "registry.isolated_key.create_succeeded", "registry.isolated_key.occurred_at_utc", "registry.isolated_key.key_path", "registry.isolated_key.value_name", "registry.isolated_key.actor_pid", "registry.isolated_key.actor_executable", "registry.isolated_key.before.value_exists", "registry.isolated_key.after.value_exists", "registry.isolated_key.after.value_data",
    "registry.run_key_native.create_succeeded", "registry.run_key_native.occurred_at_utc", "registry.run_key_native.key_path", "registry.run_key_native.value_name", "registry.run_key_native.actor_pid", "registry.run_key_native.actor_executable", "registry.run_key_native.before.value_exists", "registry.run_key_native.after.value_exists", "registry.run_key_native.after.value_kind", "registry.run_key_native.after.value_data", "registry.run_key_native.after.value_data_sha256",
    "correlation.nonce"
  ]
