{
  "schema_version": "1.1",
  "capability_id": "win.service.create",
  "version": "0.1.0",
  "display_name_zh": "服务创建",
  "display_name_en": "Service Creation",
  "description": "Actor 使用 CreateServiceW 创建本轮唯一且默认禁用的临时服务；服务仅指向系统 cmd.exe 的无害退出命令且从不启动，Controller 独立确认完整配置并精确删除。",
  "platform": { "os": "windows", "minimum_version": "10.0.17763", "architectures": ["x64"] },
  "risk_level": "L1",
  "required_privilege": "administrator",
  "controller": { "executable": "ServiceCreate.Controller.exe" },
  "participants": [{ "role": "actor", "executable": "ServiceCreate.Actor.exe" }],
  "parameters": {
    "setup_delay_ms": { "type": "integer", "required": true, "default": 750, "minimum": 0, "maximum": 30000 },
    "post_operation_hold_ms": { "type": "integer", "required": true, "default": 1500, "minimum": 0, "maximum": 30000 }
  },
  "timeouts": { "execute_seconds": 45, "cleanup_seconds": 20 },
  "network": { "required": false },
  "expected_fact_keys": [
    "service.create_succeeded", "service.occurred_at_utc", "service.completed_at_utc", "service.name",
    "service.display_name", "service.binary_path", "service.native_api", "service.actor_pid",
    "service.actor_executable", "service.actor_command_line", "service.before.exists", "service.after.exists",
    "service.after.display_name", "service.after.binary_path", "service.after.start_type", "service.after.account",
    "service.after.service_type", "service.after.state", "service.system_event_id", "service.system_event_found",
    "service.system_event_query_output", "service.diagnostic_error", "correlation.nonce"
  ]
}
