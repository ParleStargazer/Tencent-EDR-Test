{
  "schema_version": "1.1",
  "capability_id": "win.process.create",
  "version": "0.1.0",
  "display_name_zh": "进程创建",
  "display_name_en": "Process Creation",
  "description": "Controller 观察 Actor 创建 Target，并记录父子进程身份和本地证据。",
  "platform": {
    "os": "windows",
    "minimum_version": "10.0.19041",
    "architectures": [
      "x64"
    ]
  },
  "risk_level": "L0",
  "required_privilege": "standard_user",
  "controller": {
    "executable": "ProcessCreate.Controller.exe"
  },
  "participants": [
    {
      "role": "actor",
      "executable": "ProcessCreate.Actor.exe"
    },
    {
      "role": "target",
      "executable": "ProcessCreate.Target.exe"
    }
  ],
  "parameters": {
    "target_lifetime_ms": {
      "type": "integer",
      "required": true,
      "default": 5000,
      "minimum": 100,
      "maximum": 30000
    }
  },
  "timeouts": {
    "execute_seconds": 30,
    "cleanup_seconds": 10
  },
  "network": {
    "required": false
  },
  "expected_fact_keys": [
    "process.create_succeeded",
    "process.child_pid",
    "process.parent_pid",
    "correlation.nonce"
  ]
}
