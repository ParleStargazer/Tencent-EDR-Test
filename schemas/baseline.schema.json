{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edr-validation/baseline.schema.json",
  "title": "EDR Offline Validation Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "version",
    "title",
    "platform",
    "risk_level",
    "capability",
    "local_requirements",
    "correlation",
    "cloud_expectations",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "baseline_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os"],
      "properties": {
        "os": { "enum": ["windows", "linux", "macos"] },
        "versions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "architectures": {
          "type": "array",
          "items": { "enum": ["x86", "x64", "arm64"] },
          "uniqueItems": true
        }
      }
    },
    "risk_level": { "enum": ["L0", "L1", "L2", "L3"] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "parameters": { "type": "object" }
      }
    },
    "local_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/local_assertion" }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_before_seconds", "time_after_seconds", "anchors"],
      "properties": {
        "time_before_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "time_after_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "cloud_expectations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cloud_expectation" }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "required_field_weight": { "type": "number", "minimum": 0 },
        "recommended_field_weight": { "type": "number", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "deprecated"] },
        "references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "change_reason": { "type": "string" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "operator": {
      "enum": [
        "present",
        "absent",
        "equals",
        "not_equals",
        "contains",
        "regex",
        "one_of",
        "range",
        "cidr",
        "timestamp_between",
        "ref_equals"
      ]
    },
    "normalizers": {
      "type": "array",
      "items": {
        "enum": ["lowercase", "windows_path", "sid", "ip", "timestamp_utc", "trim"]
      },
      "uniqueItems": true
    },
    "local_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/$defs/operator" },
        "expected": {},
        "normalizers": { "$ref": "#/$defs/normalizers" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_field", "cloud_field", "strength"],
      "properties": {
        "local_field": { "type": "string", "minLength": 1 },
        "cloud_field": { "type": "string", "minLength": 1 },
        "strength": { "enum": ["strong", "medium", "weak"] },
        "normalizers": { "$ref": "#/$defs/normalizers" }
      }
    },
    "cloud_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event_type", "event_actions", "cardinality", "assertions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "event_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "correlation": { "$ref": "#/$defs/expectation_correlation" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cloud_assertion" }
        }
      }
    },
    "expectation_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors"],
      "properties": {
        "time_from_local": { "type": "string", "minLength": 1 },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "cloud_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "severity"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/$defs/operator" },
        "expected": {},
        "expected_from_local": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["required", "recommended", "informational"] },
        "normalizers": { "$ref": "#/$defs/normalizers" }
      }
    }
  }
}
