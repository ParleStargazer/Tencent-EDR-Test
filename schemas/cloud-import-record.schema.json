{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edr-validation/cloud-import-record.schema.json",
  "title": "Run-bound EDR Cloud Import Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "run_id",
    "status",
    "source",
    "device_name",
    "query_start_utc",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "import_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["succeeded", "failed"] },
    "source": { "const": "tencent_edr_browser_automation" },
    "device_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "query_start_utc": { "type": "string", "format": "date-time" },
    "query_end_utc": { "type": "string", "format": "date-time" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "imported_at_utc": { "type": "string", "format": "date-time" },
    "file_name": { "type": "string", "minLength": 1 },
    "manifest_file_name": { "type": "string", "minLength": 1 },
    "format": { "enum": ["json_array", "json_object", "jsonl"] },
    "record_count": { "type": "integer", "minimum": 1 },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "error_code": { "type": "string", "minLength": 1 },
    "error": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": {
        "required": ["query_end_utc", "imported_at_utc", "file_name", "manifest_file_name", "format", "record_count", "size_bytes", "sha256"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "required": ["error_code", "error"] }
    }
  ]
}
