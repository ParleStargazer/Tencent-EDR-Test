{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edr-validation/run-export.schema.json",
  "title": "EDR 本地测试轮次导出",
  "description": "一轮本地测试的可复算事实、程序身份、行为观测、清理证据与完整性信息。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "capabilities",
    "programs",
    "local_events",
    "local_facts",
    "artifacts",
    "cleanup_results",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "database_schema_version",
        "tool_version",
        "status",
        "started_at_utc",
        "ended_at_utc",
        "timezone",
        "host"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "database_schema_version": { "const": 2 },
        "tool_version": { "type": "string", "minLength": 1 },
        "suite_id": { "type": ["string", "null"] },
        "environment_id": { "type": ["string", "null"] },
        "status": { "enum": ["COMPLETED", "COMPLETED_WITH_ERRORS", "ABORTED"] },
        "started_at_utc": { "$ref": "#/$defs/date_time" },
        "ended_at_utc": { "$ref": "#/$defs/date_time" },
        "timezone": { "type": "string", "minLength": 1 },
        "utc_offset_minutes": { "type": "integer", "minimum": -840, "maximum": 840 },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time_source": { "type": ["string", "null"] },
            "synchronized": { "type": ["boolean", "null"] },
            "monotonic_frequency_hz": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "os_family",
            "os_version",
            "os_build",
            "architecture",
            "boot_time_utc"
          ],
          "properties": {
            "hostname": { "type": "string", "minLength": 1 },
            "machine_id": { "type": ["string", "null"] },
            "os_family": { "const": "windows" },
            "os_version": { "type": "string", "minLength": 1 },
            "os_build": { "type": "integer", "minimum": 1 },
            "os_edition": { "type": ["string", "null"] },
            "architecture": { "enum": ["x86", "x64", "arm64"] },
            "boot_id": { "type": ["string", "null"] },
            "boot_time_utc": { "$ref": "#/$defs/date_time" },
            "domain": { "type": ["string", "null"] },
            "primary_user_sid": { "type": ["string", "null"] },
            "agent_id_hint": { "type": ["string", "null"] },
            "agent_version_hint": { "type": ["string", "null"] }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_run_id",
          "capability_id",
          "capability_version",
          "manifest_sha256",
          "sequence",
          "nonce",
          "risk_level",
          "required_privilege",
          "status",
          "started_at_utc",
          "ended_at_utc",
          "duration_ms",
          "parameters",
          "preconditions",
          "observation_window"
        ],
        "properties": {
          "case_run_id": { "$ref": "#/$defs/id" },
          "capability_id": { "$ref": "#/$defs/capability_id" },
          "display_name_zh": { "type": ["string", "null"] },
          "display_name_en": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "capability_version": { "$ref": "#/$defs/semver" },
          "manifest_sha256": { "$ref": "#/$defs/sha256" },
          "baseline_id": { "type": ["string", "null"] },
          "baseline_version": { "type": ["string", "null"] },
          "sequence": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string", "minLength": 16 },
          "risk_level": { "enum": ["L0", "L1", "L2", "L3"] },
          "required_privilege": { "enum": ["standard_user", "administrator", "system"] },
          "status": {
            "enum": ["LOCAL_PASS", "SAMPLE_ERROR", "CLEANUP_ERROR", "SKIPPED", "ABORTED"]
          },
          "started_at_utc": { "$ref": "#/$defs/date_time" },
          "ended_at_utc": { "$ref": "#/$defs/date_time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "parameters": { "type": "object" },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "satisfied"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "satisfied": { "type": "boolean" },
                "detail": { "type": ["string", "null"] }
              }
            }
          },
          "observation_window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["started_at_utc", "ended_at_utc", "sources", "dropped_event_count"],
            "properties": {
              "started_at_utc": { "$ref": "#/$defs/date_time" },
              "ended_at_utc": { "$ref": "#/$defs/date_time" },
              "sources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "dropped_event_count": { "type": "integer", "minimum": 0 },
              "warnings": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "error_code": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] }
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_instance_id",
          "case_run_id",
          "role",
          "instance_index",
          "executable",
          "sha256",
          "pid",
          "parent_pid",
          "architecture",
          "command_line",
          "started_at_utc",
          "startup_result"
        ],
        "properties": {
          "program_instance_id": { "$ref": "#/$defs/id" },
          "case_run_id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["controller", "actor", "target", "helper"] },
          "instance_name": { "type": ["string", "null"] },
          "instance_index": { "type": "integer", "minimum": 0 },
          "executable": { "type": "string", "minLength": 1 },
          "file_name": { "type": ["string", "null"] },
          "file_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "file_created_at_utc": {
            "oneOf": [{ "$ref": "#/$defs/date_time" }, { "type": "null" }]
          },
          "file_modified_at_utc": {
            "oneOf": [{ "$ref": "#/$defs/date_time" }, { "type": "null" }]
          },
          "sha256": { "$ref": "#/$defs/sha256" },
          "sha1": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{40}$" },
          "md5": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{32}$" },
          "imphash": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{32}$" },
          "signature": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": ["string", "null"] },
              "signer": { "type": ["string", "null"] },
              "issuer": { "type": ["string", "null"] },
              "thumbprint": { "type": ["string", "null"] }
            }
          },
          "pid": { "type": "integer", "minimum": 0 },
          "parent_pid": { "type": "integer", "minimum": 0 },
          "session_id": { "type": ["integer", "null"], "minimum": 0 },
          "architecture": { "enum": ["x86", "x64", "arm64", "unknown"] },
          "command_line": { "type": "string" },
          "working_directory": { "type": ["string", "null"] },
          "user": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "sid": { "type": ["string", "null"] },
              "name": { "type": ["string", "null"] },
              "domain": { "type": ["string", "null"] }
            }
          },
          "integrity_level": { "type": ["string", "null"] },
          "elevation_type": { "type": ["string", "null"] },
          "started_at_utc": { "$ref": "#/$defs/date_time" },
          "ended_at_utc": {
            "oneOf": [{ "$ref": "#/$defs/date_time" }, { "type": "null" }]
          },
          "exit_code": { "type": ["integer", "null"] },
          "startup_result": { "$ref": "#/$defs/operation_result" }
        }
      }
    },
    "local_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/local_event" }
    },
    "local_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_fact_id",
          "case_run_id",
          "key",
          "value",
          "value_type",
          "observed_at_utc",
          "source",
          "confidence"
        ],
        "properties": {
          "local_fact_id": { "$ref": "#/$defs/id" },
          "case_run_id": { "$ref": "#/$defs/id" },
          "local_event_id": { "type": ["string", "null"] },
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
          "value": {},
          "value_type": { "enum": ["string", "integer", "number", "boolean", "null", "object", "array"] },
          "observed_at_utc": { "$ref": "#/$defs/date_time" },
          "source": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "case_run_id",
          "kind",
          "relative_path",
          "sha256",
          "size_bytes",
          "created_at_utc",
          "sensitive"
        ],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/id" },
          "case_run_id": { "$ref": "#/$defs/id" },
          "kind": { "type": "string", "minLength": 1 },
          "relative_path": { "type": "string", "minLength": 1 },
          "media_type": { "type": ["string", "null"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "created_at_utc": { "$ref": "#/$defs/date_time" },
          "sensitive": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      }
    },
    "cleanup_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cleanup_result_id",
          "case_run_id",
          "sequence",
          "action",
          "status",
          "started_at_utc",
          "ended_at_utc",
          "before",
          "after"
        ],
        "properties": {
          "cleanup_result_id": { "$ref": "#/$defs/id" },
          "case_run_id": { "$ref": "#/$defs/id" },
          "sequence": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "status": { "enum": ["succeeded", "failed", "skipped"] },
          "started_at_utc": { "$ref": "#/$defs/date_time" },
          "ended_at_utc": { "$ref": "#/$defs/date_time" },
          "before": { "type": "object" },
          "after": { "type": "object" },
          "error_message": { "type": ["string", "null"] }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_sha256",
        "database_size_bytes",
        "schema_sha256",
        "exported_at_utc",
        "exporter_version",
        "record_counts",
        "warnings"
      ],
      "properties": {
        "database_sha256": { "$ref": "#/$defs/sha256" },
        "database_size_bytes": { "type": "integer", "minimum": 0 },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "exported_at_utc": { "$ref": "#/$defs/date_time" },
        "exporter_version": { "type": "string", "minLength": 1 },
        "record_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities", "programs", "local_events", "local_facts", "artifacts", "cleanup_results"],
          "properties": {
            "capabilities": { "type": "integer", "minimum": 0 },
            "programs": { "type": "integer", "minimum": 0 },
            "local_events": { "type": "integer", "minimum": 0 },
            "local_facts": { "type": "integer", "minimum": 0 },
            "artifacts": { "type": "integer", "minimum": 0 },
            "cleanup_results": { "type": "integer", "minimum": 0 }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 16 },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded", "win32_error"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "win32_error": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": ["string", "null"] }
      }
    },
    "local_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_event_id",
        "case_run_id",
        "sequence",
        "event_type",
        "event_action",
        "nonce",
        "occurred_at_utc",
        "observed_at_utc",
        "monotonic_offset_ms",
        "source",
        "collection_method",
        "confidence",
        "data",
        "evidence_refs"
      ],
      "properties": {
        "local_event_id": { "$ref": "#/$defs/id" },
        "case_run_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": {
          "enum": [
            "process",
            "file",
            "account",
            "network",
            "hash",
            "registry",
            "scheduled_task",
            "service",
            "driver",
            "device",
            "group_policy",
            "named_pipe",
            "edr_sysops",
            "wmi",
            "bits",
            "powershell"
          ]
        },
        "event_action": { "type": "string", "minLength": 1 },
        "nonce": { "type": "string", "minLength": 16 },
        "occurred_at_utc": { "$ref": "#/$defs/date_time" },
        "observed_at_utc": { "$ref": "#/$defs/date_time" },
        "monotonic_offset_ms": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "collection_method": { "type": "string", "minLength": 1 },
        "collector_version": { "type": ["string", "null"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "actor_program_id": { "type": ["string", "null"] },
        "target_program_id": { "type": ["string", "null"] },
        "data": { "type": "object" },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/process_event" },
        { "$ref": "#/$defs/file_event" },
        { "$ref": "#/$defs/account_event" },
        { "$ref": "#/$defs/network_event" },
        { "$ref": "#/$defs/hash_event" },
        { "$ref": "#/$defs/registry_event" },
        { "$ref": "#/$defs/scheduled_task_event" },
        { "$ref": "#/$defs/service_event" },
        { "$ref": "#/$defs/driver_event" },
        { "$ref": "#/$defs/device_event" },
        { "$ref": "#/$defs/group_policy_event" },
        { "$ref": "#/$defs/named_pipe_event" },
        { "$ref": "#/$defs/edr_sysops_event" },
        { "$ref": "#/$defs/wmi_event" },
        { "$ref": "#/$defs/bits_event" },
        { "$ref": "#/$defs/powershell_event" }
      ]
    },
    "process_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "process" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "terminate", "access", "image_load", "remote_thread_create", "tamper"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/process" }
        }
      }
    },
    "file_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "file" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "open", "delete", "modify", "rename"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/file" }
        }
      }
    },
    "account_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "account" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["local_create", "local_modify", "local_delete", "login", "logoff"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/account" }
        }
      }
    },
    "network_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "network" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["tcp_connect", "udp_connect", "url_access", "dns_query", "file_download"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/network" }
        }
      }
    },
    "hash_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "hash" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["md5", "sha", "imphash"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/hash" }
        }
      }
    },
    "registry_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "registry" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "modify", "delete"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/registry" }
        }
      }
    },
    "scheduled_task_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "scheduled_task" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "modify", "delete"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/scheduled_task" }
        }
      }
    },
    "service_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "service" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "modify", "delete"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/service" }
        }
      }
    },
    "driver_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "driver" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["load", "modify", "unload"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/driver" }
        }
      }
    },
    "device_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "device" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["virtual_disk_mount", "usb_unmount", "usb_mount"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/device" }
        }
      }
    },
    "group_policy_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "group_policy" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "const": "modify" },
          "data": { "$ref": "local-event-data.schema.json#/$defs/group_policy" }
        }
      }
    },
    "named_pipe_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "named_pipe" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["create", "connect"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/named_pipe" }
        }
      }
    },
    "edr_sysops_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "edr_sysops" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["agent_start", "agent_stop", "agent_install", "agent_uninstall", "agent_keep_alive", "agent_error"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/edr_sysops" }
        }
      }
    },
    "wmi_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "wmi" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "enum": ["consumer_filter_bind", "consumer", "filter"] },
          "data": { "$ref": "local-event-data.schema.json#/$defs/wmi" }
        }
      }
    },
    "bits_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "bits" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "const": "job" },
          "data": { "$ref": "local-event-data.schema.json#/$defs/bits" }
        }
      }
    },
    "powershell_event": {
      "if": { "type": "object", "properties": { "event_type": { "const": "powershell" } }, "required": ["event_type"] },
      "then": {
        "type": "object",
        "properties": {
          "event_action": { "const": "script_block" },
