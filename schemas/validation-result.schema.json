{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edr-validation/validation-result.schema.json",
  "title": "EDR Offline Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "compared_at_utc",
    "inputs",
    "summary",
    "conclusion",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "comparison_id": { "type": "string", "minLength": 16 },
    "compared_at_utc": { "type": "string", "format": "date-time" },
    "comparator_version": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_export", "cloud_exports", "mapping_profiles", "baselines"],
      "properties": {
        "local_export": { "$ref": "#/$defs/file_ref" },
        "cloud_exports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file_ref" }
        },
        "cloud_manifest": {
          "oneOf": [{ "$ref": "#/$defs/file_ref" }, { "type": "null" }]
        },
        "mapping_profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/versioned_ref" }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/versioned_ref" }
        },
        "action_name_standards": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 },
            "uniqueItems": true
          }
        },
        "child_file_create_op_name_standards": {
          "type": "object",
          "propertyNames": {
            "enum": ["win.file.create", "win.file.open", "win.file.delete", "win.file.modify", "win.file.rename"]
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 },
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "partial", "fail", "inconclusive", "not_compared"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "not_compared": { "type": "integer", "minimum": 0 },
        "event_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "field_completeness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "determinacy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "label_zh",
        "statement_zh",
        "total_capabilities",
        "compared_capabilities",
        "pass_rate",
        "passed_capability_ids",
        "gap_capability_ids",
        "uncertain_capability_ids"
      ],
      "properties": {
        "verdict": { "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"] },
        "label_zh": { "type": "string", "minLength": 1 },
        "statement_zh": { "type": "string", "minLength": 1 },
        "total_capabilities": { "type": "integer", "minimum": 0 },
        "compared_capabilities": { "type": "integer", "minimum": 0 },
        "pass_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "passed_capability_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "gap_capability_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertain_capability_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_run_id",
          "capability_id",
          "local_status",
          "validation_status",
          "export_coverage",
          "candidate_count",
          "local_export_block",
          "local_baseline_matches",
          "assertions",
          "method_selection",
          "method_results",
          "stage_flow",
          "stage_results"
        ],
        "properties": {
          "case_run_id": { "type": "string", "minLength": 16 },
          "capability_id": { "type": "string", "minLength": 1 },
          "display_name_zh": { "type": ["string", "null"] },
          "display_name_en": { "type": ["string", "null"] },
          "baseline_id": { "type": ["string", "null"] },
          "baseline_version": { "type": ["string", "null"] },
          "baseline_title": { "type": ["string", "null"] },
          "local_status": {
            "enum": ["LOCAL_PASS", "SAMPLE_ERROR", "CLEANUP_ERROR", "SKIPPED", "ABORTED"]
          },
          "validation_status": {
            "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE", "NOT_COMPARED"]
          },
          "export_coverage": { "enum": ["verified", "inferred", "assumed", "insufficient"] },
          "candidate_count": { "type": "integer", "minimum": 0 },
          "method_selection": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["strategy", "selected_method_id", "selected_method_title", "selected_method_status", "notice"],
                "properties": {
                  "strategy": { "const": "best" },
                  "selected_method_id": { "type": "string", "minLength": 1 },
                  "selected_method_title": { "type": "string", "minLength": 1 },
                  "selected_method_status": { "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"] },
                  "notice": { "type": "string", "minLength": 1 }
                }
              },
              { "type": "null" }
            ]
          },
          "method_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method_id",
                "method_title",
                "expectation_id",
                "status",
                "selected_for_conclusion",
                "candidate_count",
                "qualified_candidate_count",
                "passed_requirement_count",
                "requirement_count",
                "warnings"
              ],
              "properties": {
                "method_id": { "type": "string", "minLength": 1 },
                "method_title": { "type": "string", "minLength": 1 },
                "expectation_id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"] },
                "selected_for_conclusion": { "type": "boolean" },
                "candidate_count": { "type": "integer", "minimum": 0 },
                "qualified_candidate_count": { "type": "integer", "minimum": 0 },
                "passed_requirement_count": { "type": "integer", "minimum": 0 },
                "requirement_count": { "type": "integer", "minimum": 0 },
                "warnings": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "stage_flow": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["strategy", "status", "stage_count", "notice"],
                "properties": {
                  "strategy": { "const": "ordered_all" },
                  "status": { "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"] },
                  "stage_count": { "type": "integer", "minimum": 1 },
                  "notice": { "type": "string", "minLength": 1 }
                }
              },
              { "type": "null" }
            ]
          },
          "stage_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence", "title", "expectation_id", "depends_on", "status",
                "candidate_count", "qualified_candidate_count", "selected_event",
                "order_status", "order_message", "warnings"
              ],
              "properties": {
                "sequence": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 },
                "expectation_id": { "type": "string", "minLength": 1 },
                "depends_on": { "type": ["string", "null"] },
                "status": { "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"] },
                "candidate_count": { "type": "integer", "minimum": 0 },
                "qualified_candidate_count": { "type": "integer", "minimum": 0 },
                "selected_event": { "type": ["object", "null"] },
                "order_status": { "enum": ["passed", "failed", "not_evaluated", null] },
                "order_message": { "type": ["string", "null"] },
                "warnings": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "selected_event": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["raw_ref", "event_id", "correlation_score"],
                "properties": {
                  "raw_ref": { "type": "string", "minLength": 1 },
                  "event_id": { "type": ["string", "null"] },
                  "correlation_score": { "type": "number", "minimum": 0 },
                  "confidence": { "enum": ["high", "medium", "low"] },
                  "anchor_qualified": { "type": "boolean" },
                  "eligible_for_validation": { "type": "boolean" },
                  "qualification_reason": { "type": "string" },
                  "custom_action_name_expected": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "custom_action_name_actual": { "type": ["string", "null"] },
                  "custom_action_name_matched": { "type": ["boolean", "null"] },
                  "custom_child_file_create_op_name_expected": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "custom_child_file_create_op_name_actual": { "type": ["string", "null"] },
                  "custom_child_file_create_op_name_matched": { "type": ["boolean", "null"] },
                  "maximum_time_difference_ms": { "type": "integer", "minimum": 1 },
                  "time_difference_matched": { "type": "boolean" },
                  "time_distance_ms": { "type": "integer", "minimum": 0 },
                  "time_offset_ms": { "type": ["integer", "null"] },
                  "local_event_time_utc": { "type": "string", "format": "date-time" },
                  "event_time_utc": { "type": ["string", "null"], "format": "date-time" },
                  "matched_anchors": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              { "type": "null" }
            ]
          },
          "edr_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expectation_id",
                "rank",
                "confidence",
                "correlation_score",
                "anchor_qualified",
                "eligible_for_validation",
                "qualification_reason",
                "event_type_hint_matched",
                "event_action_hint_matched",
                "custom_action_name_expected",
                "custom_action_name_actual",
                "custom_action_name_matched",
                "custom_child_file_create_op_name_expected",
                "custom_child_file_create_op_name_actual",
                "custom_child_file_create_op_name_matched",
                "maximum_time_difference_ms",
                "time_difference_matched",
                "time_distance_ms",
                "time_offset_ms",
                "local_event_time_utc",
                "raw_ref",
                "matched_anchors",
                "baseline_matches",
                "canonical_event",
                "raw_event"
              ],
              "properties": {
                "expectation_id": { "type": "string", "minLength": 1 },
                "rank": { "type": "integer", "minimum": 1 },
                "confidence": { "enum": ["high", "medium", "low"] },
                "correlation_score": { "type": "number", "minimum": 0 },
                "anchor_qualified": { "type": "boolean" },
                "eligible_for_validation": { "type": "boolean" },
                "qualification_reason": { "type": "string", "minLength": 1 },
                "event_type_hint_matched": { "type": "boolean" },
                "event_action_hint_matched": { "type": "boolean" },
                "custom_action_name_expected": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "custom_action_name_actual": { "type": ["string", "null"] },
                "custom_action_name_matched": { "type": ["boolean", "null"] },
                "custom_child_file_create_op_name_expected": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "custom_child_file_create_op_name_actual": { "type": ["string", "null"] },
                "custom_child_file_create_op_name_matched": { "type": ["boolean", "null"] },
                "maximum_time_difference_ms": { "type": "integer", "minimum": 1 },
                "time_difference_matched": { "type": "boolean" },
                "time_distance_ms": { "type": "integer", "minimum": 0 },
                "time_offset_ms": { "type": ["integer", "null"] },
                "local_event_time_utc": { "type": "string", "format": "date-time" },
                "event_time_utc": { "type": ["string", "null"], "format": "date-time" },
                "raw_ref": { "type": "string", "minLength": 1 },
                "event_id": { "type": ["string", "null"] },
                "matched_anchors": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "baseline_matches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "requirement_id",
                      "status",
                      "local_field",
                      "local_json_pointer",
                      "canonical_field",
                      "raw_field",
                      "raw_json_pointer",
                      "expected",
                      "actual",
                      "message"
                    ],
                    "properties": {
                      "kind": { "enum": ["correlation", "assertion", "custom_filter"] },
                      "requirement_id": { "type": "string", "minLength": 1 },
                      "status": { "enum": ["passed", "failed", "not_evaluated"] },
                      "local_field": { "type": ["string", "null"] },
                      "local_json_pointer": { "type": ["string", "null"] },
                      "canonical_field": { "type": "string", "minLength": 1 },
                      "raw_field": { "type": ["string", "null"] },
                      "raw_json_pointer": { "type": ["string", "null"] },
                      "expected": {},
                      "actual": {},
                      "message": { "type": ["string", "null"] }
                    }
                  }
                },
                "canonical_event": { "type": "object" },
                "raw_event": { "type": "object" }
              }
            }
          },
          "local_export_block": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run",
              "capability",
              "programs",
              "local_events",
              "local_facts",
              "artifacts",
              "cleanup_results",
              "execution_logs"
            ],
            "properties": {
              "run": { "type": "object" },
              "capability": { "type": "object" },
              "programs": { "type": "array" },
              "local_events": { "type": "array" },
              "local_facts": { "type": "array" },
              "artifacts": { "type": "array" },
              "cleanup_results": { "type": "array" },
              "execution_logs": { "type": "array" }
            }
          },
          "local_baseline_matches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement_id", "status", "field", "json_pointer", "expected", "actual"],
              "properties": {
                "requirement_id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["passed", "failed", "not_evaluated"] },
                "field": { "type": "string", "minLength": 1 },
                "json_pointer": { "type": ["string", "null"] },
                "expected": {},
                "actual": {}
              }
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "operator", "severity", "status"],
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "operator": { "type": "string", "minLength": 1 },
                "severity": { "enum": ["required", "recommended", "informational"] },
                "status": { "enum": ["passed", "failed", "not_evaluated"] },
                "expected": {},
                "actual": {},
                "message": { "type": ["string", "null"] }
              }
            }
          },
          "baseline_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "scope",
                "title_zh",
                "field",
                "operator",
                "severity",
                "status"
              ],
              "properties": {
                "requirement_id": { "type": "string", "minLength": 1 },
                "scope": { "enum": ["local", "cloud"] },
                "title_zh": { "type": "string", "minLength": 1 },
                "expectation_id": { "type": ["string", "null"] },
                "field": { "type": "string", "minLength": 1 },
                "operator": { "type": "string", "minLength": 1 },
                "severity": { "enum": ["required", "recommended", "informational"] },
                "status": { "enum": ["passed", "failed", "not_evaluated"] },
                "expected": {},
                "actual": {},
                "message": { "type": ["string", "null"] }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
