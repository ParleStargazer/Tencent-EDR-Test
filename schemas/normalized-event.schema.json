{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/edr-validation/normalized-event.schema.json",
  "title": "EDR Validation Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "host", "source", "raw_ref"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "event": {
      "type": "object",
      "required": ["id", "type", "created"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "action": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "created": { "type": "string", "format": "date-time" },
        "observed": { "type": ["string", "null"], "format": "date-time" },
        "ingested": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hostname": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "agent_id": { "type": ["string", "null"] },
        "agent_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "process": { "$ref": "#/$defs/process" },
    "parent_process": { "$ref": "#/$defs/process" },
    "source_process": { "$ref": "#/$defs/process" },
    "thread": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["integer", "null"], "minimum": 0 },
        "start_address": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "user": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "target": {
          "type": ["object", "null"],
          "properties": {
            "id": { "type": ["string", "null"] },
            "name": { "type": ["string", "null"] },
            "domain": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "winlog": {
      "type": ["object", "null"],
      "properties": {
        "event_id": { "type": ["integer", "string", "null"] },
        "logon": {
          "type": ["object", "null"],
          "properties": {
            "id": { "type": ["string", "null"] },
            "type": { "type": ["integer", "string", "null"] },
            "authentication_package": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": ["object", "null"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "old_path": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "created": { "type": ["string", "null"], "format": "date-time" },
        "modified": { "type": ["string", "null"], "format": "date-time" },
        "accessed": { "type": ["string", "null"], "format": "date-time" },
        "operation_name": { "type": ["string", "null"] },
        "content_type": { "type": ["string", "null"] },
        "format": { "type": ["string", "null"] },
        "driver_type": { "type": ["string", "null"] },
        "encrypted": { "type": ["string", "boolean", "integer", "null"] },
        "io": {
          "type": ["object", "null"],
          "properties": {
            "read_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "write_bytes": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "hash": {
          "type": ["object", "null"],
          "properties": {
            "md5": { "type": ["string", "null"] },
            "sha1": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"] },
            "sha512": { "type": ["string", "null"] },
            "imphash": { "type": ["string", "null"] },
            "sha_type": { "type": ["string", "integer", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": ["object", "null"],
      "properties": {
        "key": { "type": ["string", "null"] },
        "value_name": { "type": ["string", "null"] },
        "value_data": {},
        "old_value_data": {},
        "value_type": { "type": ["string", "integer", "null"] },
        "old_value_type": { "type": ["string", "integer", "null"] },
        "group_name": { "type": ["string", "null"] },
        "monitor_name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "named_pipe": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "node_name": { "type": ["string", "null"] },
        "operation_name": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "scheduled_task": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "content": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "arguments": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "service": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "binary_path": { "type": ["string", "null"] },
        "start_type": { "type": ["string", "integer", "null"] },
        "old_start_type": { "type": ["string", "integer", "null"] },
        "account": { "type": ["string", "null"] },
        "service_type": { "type": ["string", "integer", "null"] },
        "state": { "type": ["string", "integer", "null"] }
      },
      "additionalProperties": false
    },
    "network": {
      "type": ["object", "null"],
      "properties": {
        "transport": { "type": ["string", "null"] },
        "direction": { "type": ["string", "null"] },
        "source_ip": { "type": ["string", "null"] },
        "source_port": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
        "destination_ip": { "type": ["string", "null"] },
        "destination_port": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "dns": {
      "type": ["object", "null"],
      "properties": {
        "question": { "type": ["string", "null"] },
        "answers": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "url": {
      "type": ["object", "null"],
      "properties": {
        "full": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "scheme": { "type": ["string", "null"] },
        "port": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "http": {
      "type": ["object", "null"],
      "properties": {
        "request": {
          "type": ["object", "null"],
          "properties": { "method": { "type": ["string", "null"] } },
          "additionalProperties": false
        },
        "response": {
          "type": ["object", "null"],
          "properties": { "status_code": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "powershell": {
      "type": ["object", "null"],
      "properties": {
        "content": { "type": ["string", "null"] },
        "content_name": { "type": ["string", "null"] },
        "content_type": { "type": ["string", "null"] },
        "hook_module": { "type": ["string", "null"] },
        "app_version": { "type": ["string", "integer", "null"] },
        "monitor_name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "bits": {
      "type": ["object", "null"],
      "properties": {
        "job_id": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "job_type": { "type": ["string", "integer", "null"] },
        "state": { "type": ["string", "integer", "null"] },
        "owner_sid": { "type": ["string", "null"] },
        "remote_url": { "type": ["string", "null"] },
        "local_path": { "type": ["string", "null"] },
        "bytes_total": { "type": ["integer", "null"], "minimum": 0 },
        "bytes_transferred": { "type": ["integer", "null"], "minimum": 0 },
        "notification_command": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "correlation": {
      "type": ["object", "null"],
      "properties": {
        "run_id": { "type": ["string", "null"] },
        "case_id": { "type": ["string", "null"] },
        "nonce": { "type": ["string", "null"] },
        "matched_anchors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["vendor", "importer", "mapping_version"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "importer": { "type": "string", "minLength": 1 },
        "mapping_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "extensions": { "type": "object" },
    "raw_ref": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "process": {
      "type": ["object", "null"],
      "properties": {
        "entity_id": { "type": ["string", "null"] },
        "pid": { "type": ["integer", "null"], "minimum": 0 },
        "name": { "type": ["string", "null"] },
        "executable": { "type": ["string", "null"] },
        "command_line": { "type": ["string", "null"] },
        "start": { "type": ["string", "null"], "format": "date-time" },
        "end": { "type": ["string", "null"], "format": "date-time" },
        "exit_code": { "type": ["integer", "null"] },
        "hash": {
          "type": ["object", "null"],
          "properties": {
            "md5": { "type": ["string", "null"] },
            "sha1": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
